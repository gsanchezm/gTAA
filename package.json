{
  "name": "gtaa-baseline",
  "version": "1.0.0",
  "private": true,
  "description": "gTAA-inspired layered test automation architecture baseline for cross-platform test automation research.",
  "license": "ISC",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "20 || 22 || >=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "cucumber-js",
    "test:web:desktop": "cross-env GTAA_PLATFORM=desktop GTAA_DRIVER=playwright cucumber-js --tags \"@desktop\" --format json:results/web-desktop.json",
    "test:web:responsive": "cross-env GTAA_PLATFORM=responsive GTAA_DRIVER=playwright cucumber-js --tags \"@responsive\" --format json:results/web-responsive.json",
    "test:android": "cross-env GTAA_PLATFORM=android GTAA_DRIVER=appium cucumber-js --tags \"@android\" --format json:results/android.json",
    "test:ios": "cross-env GTAA_PLATFORM=ios GTAA_DRIVER=appium cucumber-js --tags \"@ios\" --format json:results/ios.json",
    "test:api": "cross-env GTAA_PLATFORM=api GTAA_DRIVER=api cucumber-js --tags \"@api\" --format json:results/api.json",
    "test:visual:desktop": "cross-env GTAA_PLATFORM=desktop GTAA_DRIVER=playwright GTAA_VISUAL=true cucumber-js --tags \"@desktop and @visual\" --format json:results/visual-desktop.json",
    "test:visual:responsive": "cross-env GTAA_PLATFORM=responsive GTAA_DRIVER=playwright GTAA_VISUAL=true cucumber-js --tags \"@responsive and @visual\" --format json:results/visual-responsive.json",
    "perf:generate": "tsx src/gtaa/test-execution/gatling/generate-feeder.ts",
    "perf:smoke": "cross-env PERF_PROFILE=smoke tsx src/gtaa/test-execution/gatling/run-simulation.ts",
    "perf:load": "cross-env PERF_PROFILE=load tsx src/gtaa/test-execution/gatling/run-simulation.ts",
    "perf:stress": "cross-env PERF_PROFILE=stress tsx src/gtaa/test-execution/gatling/run-simulation.ts",
    "metrics:manifest": "tsx scripts/metrics/generate-run-manifest.ts",
    "metrics:inventory": "tsx scripts/metrics/extract-scenario-inventory.ts",
    "metrics:coverage": "tsx scripts/metrics/build-platform-coverage.ts",
    "metrics:normalize": "tsx scripts/metrics/normalize-telemetry.ts",
    "metrics:durations": "tsx scripts/metrics/aggregate-durations.ts",
    "metrics:api": "tsx scripts/metrics/normalize-api-telemetry.ts",
    "metrics:visual": "tsx scripts/metrics/normalize-visual-telemetry.ts",
    "metrics:performance": "tsx scripts/metrics/normalize-gatling-telemetry.ts",
    "metrics:failures": "tsx scripts/metrics/build-failure-buckets.ts",
    "metrics:outcomes": "tsx scripts/metrics/build-outcome-history.ts",
    "metrics:tables": "tsx scripts/metrics/build-article-tables.ts",
    "metrics:all": "pnpm metrics:inventory && pnpm metrics:coverage && pnpm metrics:normalize && pnpm metrics:durations && pnpm metrics:api && pnpm metrics:visual && pnpm metrics:performance && pnpm metrics:failures && pnpm metrics:outcomes && pnpm metrics:tables",
    "metrics:quality:maintainability": "tsx scripts/metrics/measure-maintainability.ts",
    "metrics:quality:modifiability": "tsx scripts/metrics/measure-modifiability.ts",
    "metrics:quality:extensibility": "tsx scripts/metrics/measure-extensibility.ts",
    "metrics:quality:reusability": "tsx scripts/metrics/measure-reusability.ts",
    "metrics:quality:reliability": "tsx scripts/metrics/measure-reliability.ts",
    "metrics:quality:performance": "tsx scripts/metrics/measure-performance-efficiency.ts",
    "metrics:quality:observability": "tsx scripts/metrics/measure-observability.ts",
    "metrics:quality:portability": "tsx scripts/metrics/measure-portability.ts",
    "metrics:quality:interoperability": "tsx scripts/metrics/measure-interoperability.ts",
    "metrics:quality:summary": "tsx scripts/metrics/build-quality-attribute-summary.ts",
    "metrics:quality:all": "pnpm metrics:quality:maintainability && pnpm metrics:quality:modifiability && pnpm metrics:quality:extensibility && pnpm metrics:quality:reusability && pnpm metrics:quality:reliability && pnpm metrics:quality:performance && pnpm metrics:quality:observability && pnpm metrics:quality:portability && pnpm metrics:quality:interoperability && pnpm metrics:quality:summary"
  },
  "dependencies": {
    "@gatling.io/core": "3.14.903",
    "@gatling.io/http": "3.14.903",
    "appium": "^3.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "webdriverio": "^9.27.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@gatling.io/cli": "3.14.903",
    "@types/node": "^25.7.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "appium-uiautomator2-driver": "^7.3.0",
    "appium-xcuitest-driver": "^11.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
