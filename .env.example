# gTAA baseline environment configuration (sample). Copy to .env and adjust.
# No secrets are read into telemetry; sensitive payloads are hashed before emission.

# --- Application under test (same target as the TOM reference for a fair comparison) ---
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# --- Active execution context (usually set by the test:* scripts, not here) ---
# GTAA_PLATFORM: desktop | responsive | android | ios | api
GTAA_PLATFORM=desktop
# GTAA_DRIVER: playwright | appium | api
GTAA_DRIVER=playwright
GTAA_VISUAL=false

# --- Experiment / pairing identity (set by CI for paired TOM vs gTAA runs) ---
ARCHITECTURE_TYPE=GTAA_BASELINE
REPOSITORY_NAME=gTAA
EXPERIMENT_BATCH_ID=local-batch
RUN_INDEX=0
TARGET_ENVIRONMENT=local

# --- Viewports ---
DESKTOP_WIDTH=1440
DESKTOP_HEIGHT=900
RESPONSIVE_WIDTH=390
RESPONSIVE_HEIGHT=844

# --- Web driver ---
HEADLESS=true
WEB_TIMEOUT_MS=20000

# --- Appium (mobile) ---
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
ANDROID_APP_PATH=
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
IOS_APP_PATH=
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=
MOBILE_TIMEOUT_MS=30000

# --- Performance (Gatling) ---
PERF_PROFILE=smoke
PERF_USERS=5
PERF_DURATION=30

# --- Visual ---
# Set to "true" only when intentionally regenerating baselines.
UPDATE_VISUAL_BASELINE=false
VISUAL_PIXEL_RATIO=0.005

# --- Logging ---
LOG_LEVEL=info
